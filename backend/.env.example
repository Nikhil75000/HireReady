APP_NAME=AI Resume Interview Copilot API
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

GROQ_API_KEY=your_groq_api_key_here

# Hugging Face token (read-only) for hosted resume-chunk embeddings (Inference API)
HF_TOKEN=your_huggingface_token_here

SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# GitHub OAuth app (for "connect GitHub" flow); GITHUB_TOKEN is a server PAT used for the guest/manual-username flow
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_TOKEN=your_github_personal_access_token_here
